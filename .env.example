# ==============================================================
# CapIAu-CurIA — Variáveis de Ambiente para Produção (Vercel)
# ==============================================================
# Cadastre estas variáveis no painel do seu projeto na Vercel:
# Settings -> Environment Variables

# --- Provedores LLM / Inteligência Artificial (Obrigatório ter pelo menos 1) ---
# Obtenha grátis em https://aistudio.google.com/app/apikey (Recomendado ⚡)
GEMINI_API_KEY=
# Obtenha em https://openrouter.ai/keys (Fallback para modelos adicionais)
OPENROUTER_API_KEY=

# --- Mecanismos de Busca na Web ---
# Serper.dev (Google Search & Shopping) — https://serper.dev
SERPER_API_KEY=
# Tavily (Resumos técnicos e RAG) — https://tavily.com
TAVILY_API_KEY=
# Exa.ai (Busca Semântica Neural) — https://exa.ai
EXA_API_KEY=

# --- Scraping & Extração Avançada (Opcionais) ---
# Firecrawl (Markdown limpo para LLMs) — https://firecrawl.dev
FIRECRAWL_API_KEY=
# Scrape.do (Proxy rotativo anti-bloqueio) — https://scrape.do
SCRAPEDO_API_KEY=
# Diffbot (Extração estruturada de artigos) — https://diffbot.com
DIFFBOT_API_KEY=

# --- Reddit API OAuth (Opcional — fallback automático via Serper) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
